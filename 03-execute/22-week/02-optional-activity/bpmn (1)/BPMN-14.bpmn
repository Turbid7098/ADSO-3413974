<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_bpmn14" targetNamespace="http://sena.edu.co/bpmn/bpmn14" exporter="Camunda Modeler" exporterVersion="5.50.1">
  <bpmn:collaboration id="Collaboration_bpmn14">
    <bpmn:participant id="Pool_bpmn14" name="Gestion documental" processRef="Process_bpmn14" />
  </bpmn:collaboration>
  <bpmn:process id="Process_bpmn14" name="Gestion documental" isExecutable="false">
    <bpmn:laneSet id="LaneSet_bpmn14">
      <bpmn:lane id="Lane_bpmn14_1" name="Sistema">
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_bpmn14_0" name="Soporte (ADMIN_STAFF)">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Necesidad de generar o consultar documento">
      <bpmn:outgoing>Flow_bpmn14_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="t1" name="Seleccionar plantilla de documento">
      <bpmn:incoming>Flow_bpmn14_0</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn14_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t2" name="Editar o previsualizar plantilla">
      <bpmn:incoming>Flow_bpmn14_1</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn14_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t3" name="Generar documento con datos de origen">
      <bpmn:incoming>Flow_bpmn14_2</bpmn:incoming>
      <bpmn:incoming>Flow_bpmn14_6</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn14_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t4" name="Validar datos requeridos">
      <bpmn:incoming>Flow_bpmn14_3</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn14_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g1" name="Datos completos para generar?">
      <bpmn:incoming>Flow_bpmn14_4</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn14_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_bpmn14_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t6" name="Generar documento y registrar version">
      <bpmn:incoming>Flow_bpmn14_7</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn14_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="e1" name="Documento generado">
      <bpmn:incoming>Flow_bpmn14_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="t5" name="Informar informacion faltante">
      <bpmn:incoming>Flow_bpmn14_5</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn14_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_bpmn14_0" sourceRef="s1" targetRef="t1" />
    <bpmn:sequenceFlow id="Flow_bpmn14_1" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="Flow_bpmn14_2" sourceRef="t2" targetRef="t3" />
    <bpmn:sequenceFlow id="Flow_bpmn14_6" sourceRef="t5" targetRef="t3" />
