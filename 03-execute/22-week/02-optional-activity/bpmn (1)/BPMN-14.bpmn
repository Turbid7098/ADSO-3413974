    <bpmn:sequenceFlow id="Flow_bpmn14_4" sourceRef="t4" targetRef="g1" />
    <bpmn:sequenceFlow id="Flow_bpmn14_5" name="No" sourceRef="g1" targetRef="t5" />
    <bpmn:sequenceFlow id="Flow_bpmn14_7" name="Si" sourceRef="g1" targetRef="t6" />
    <bpmn:sequenceFlow id="Flow_bpmn14_8" sourceRef="t6" targetRef="e1" />
  </bpmn:process>
