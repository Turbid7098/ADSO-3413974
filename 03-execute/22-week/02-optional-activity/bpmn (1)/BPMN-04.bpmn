<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_bpmn04" targetNamespace="http://sena.edu.co/bpmn/bpmn04" exporter="Camunda Modeler" exporterVersion="5.50.1">
  <bpmn:collaboration id="Collaboration_bpmn04">
    <bpmn:participant id="Pool_bpmn04" name="Resolucion de conflictos de horario" processRef="Process_bpmn04" />
  </bpmn:collaboration>
  <bpmn:process id="Process_bpmn04" name="Resolucion de conflictos de horario" isExecutable="false">
    <bpmn:laneSet id="LaneSet_bpmn04">
      <bpmn:lane id="Lane_bpmn04_1" name="Sistema">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_bpmn04_0" name="Coordinador">
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Conflicto de horario detectado">
      <bpmn:outgoing>Flow_bpmn04_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="t1" name="Registrar conflicto en el panel">
      <bpmn:incoming>Flow_bpmn04_0</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn04_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t2" name="Consultar panel de conflictos">
      <bpmn:incoming>Flow_bpmn04_1</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn04_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t3" name="Seleccionar conflicto a resolver">
      <bpmn:incoming>Flow_bpmn04_2</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn04_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t4" name="Documentar justificacion de la resolucion">
      <bpmn:incoming>Flow_bpmn04_3</bpmn:incoming>
      <bpmn:incoming>Flow_bpmn04_6</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn04_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g1" name="Justificacion registrada?">
      <bpmn:incoming>Flow_bpmn04_4</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn04_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_bpmn04_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t6" name="Registrar resolucion (auditoria usuario y fecha)">
      <bpmn:incoming>Flow_bpmn04_7</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn04_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="e1" name="Conflicto resuelto">
      <bpmn:incoming>Flow_bpmn04_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_bpmn04_0" sourceRef="s1" targetRef="t1" />
    <bpmn:sequenceFlow id="Flow_bpmn04_1" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="Flow_bpmn04_2" sourceRef="t2" targetRef="t3" />
    <bpmn:sequenceFlow id="Flow_bpmn04_3" sourceRef="t3" targetRef="t4" />
    <bpmn:sequenceFlow id="Flow_bpmn04_6" sourceRef="t5" targetRef="t4" />
    <bpmn:sequenceFlow id="Flow_bpmn04_4" sourceRef="t4" targetRef="g1" />
    <bpmn:sequenceFlow id="Flow_bpmn04_5" name="No" sourceRef="g1" targetRef="t5" />
    <bpmn:sequenceFlow id="Flow_bpmn04_7" name="Si" sourceRef="g1" targetRef="t6" />
    <bpmn:sequenceFlow id="Flow_bpmn04_8" sourceRef="t6" targetRef="e1" />
    <bpmn:task id="t5" name="Informar campo obligatorio faltante">
      <bpmn:incoming>Flow_bpmn04_5</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn04_6</bpmn:outgoing>
    </bpmn:task>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_bpmn04">
    <bpmndi:BPMNPlane id="Plane_bpmn04" bpmnElement="Collaboration_bpmn04">
      <bpmndi:BPMNShape id="Pool_bpmn04_di" bpmnElement="Pool_bpmn04" isHorizontal="true">
        <omgdc:Bounds x="150" y="80" width="1565" height="430" />
