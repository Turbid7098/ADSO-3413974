<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_bpmn06" targetNamespace="http://sena.edu.co/bpmn/bpmn06">
  <bpmn:collaboration id="Collaboration_bpmn06">
    <bpmn:participant id="Pool_bpmn06" name="Consulta de horario" processRef="Process_bpmn06"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_bpmn06" name="Consulta de horario" isExecutable="false">
    <bpmn:laneSet id="LaneSet_bpmn06">
      <bpmn:lane id="Lane_bpmn06_0" name="Usuario (Instructor / Aprendiz)">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_bpmn06_1" name="Sistema">
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Necesidad de consultar horario"><bpmn:outgoing>Flow_bpmn06_0</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="t1" name="Seleccionar semana a consultar"><bpmn:incoming>Flow_bpmn06_0</bpmn:incoming><bpmn:outgoing>Flow_bpmn06_1</bpmn:outgoing></bpmn:task>
    <bpmn:task id="t2" name="Validar alcance de acceso (ficha propia)"><bpmn:incoming>Flow_bpmn06_1</bpmn:incoming><bpmn:outgoing>Flow_bpmn06_2</bpmn:outgoing></bpmn:task>
    <bpmn:task id="t3" name="Obtener sesiones de la semana"><bpmn:incoming>Flow_bpmn06_2</bpmn:incoming><bpmn:outgoing>Flow_bpmn06_3</bpmn:outgoing></bpmn:task>
    <bpmn:task id="t4" name="Seleccionar sesion para ver detalle"><bpmn:incoming>Flow_bpmn06_3</bpmn:incoming><bpmn:outgoing>Flow_bpmn06_4</bpmn:outgoing></bpmn:task>
    <bpmn:task id="t5" name="Presentar detalle de la sesion"><bpmn:incoming>Flow_bpmn06_4</bpmn:incoming><bpmn:outgoing>Flow_bpmn06_5</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="e1" name="Horario consultado"><bpmn:incoming>Flow_bpmn06_5</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_bpmn06_0" sourceRef="s1" targetRef="t1"/>
    <bpmn:sequenceFlow id="Flow_bpmn06_1" sourceRef="t1" targetRef="t2"/>
    <bpmn:sequenceFlow id="Flow_bpmn06_2" sourceRef="t2" targetRef="t3"/>
    <bpmn:sequenceFlow id="Flow_bpmn06_3" sourceRef="t3" targetRef="t4"/>
    <bpmn:sequenceFlow id="Flow_bpmn06_4" sourceRef="t4" targetRef="t5"/>
    <bpmn:sequenceFlow id="Flow_bpmn06_5" sourceRef="t5" targetRef="e1"/>
  </bpmn:process>
