      <bpmn:outgoing>Flow_bpmn01_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="e1" name="Acceso concedido">
      <bpmn:incoming>Flow_bpmn01_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="e2" name="Acceso restringido (403)">
      <bpmn:incoming>Flow_bpmn01_14</bpmn:incoming>
    </bpmn:endEvent>
