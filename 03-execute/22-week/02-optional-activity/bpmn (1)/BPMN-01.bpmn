        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_bpmn01_0" name="Usuario">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Solicitud de acceso">
      <bpmn:outgoing>Flow_bpmn01_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="g0" name="Recuerda su contrasena?">
      <bpmn:incoming>Flow_bpmn01_0</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn01_1</bpmn:outgoing>
      <bpmn:outgoing>Flow_bpmn01_2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t4" name="Enviar enlace de recuperacion">
      <bpmn:incoming>Flow_bpmn01_4</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn01_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t6" name="Informar error de autenticacion">
      <bpmn:incoming>Flow_bpmn01_8</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn01_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t7" name="Identificar rol y permisos (RBAC)">
      <bpmn:incoming>Flow_bpmn01_10</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn01_11</bpmn:outgoing>
    </bpmn:task>
