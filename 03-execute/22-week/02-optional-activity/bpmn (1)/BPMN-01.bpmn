  <bpmn:collaboration id="Collaboration_bpmn01">
    <bpmn:participant id="Pool_bpmn01" name="Autenticacion y acceso" processRef="Process_bpmn01" />
  </bpmn:collaboration>
  <bpmn:process id="Process_bpmn01" name="Autenticacion y acceso" isExecutable="false">
    <bpmn:laneSet id="LaneSet_bpmn01">
      <bpmn:lane id="Lane_bpmn01_1" name="Sistema">
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
