<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_bpmn02" targetNamespace="http://sena.edu.co/bpmn/bpmn02" exporter="Camunda Modeler" exporterVersion="5.50.1">
  <bpmn:collaboration id="Collaboration_bpmn02">
    <bpmn:participant id="Pool_bpmn02" name="Construccion de horario en borrador" processRef="Process_bpmn02" />
  </bpmn:collaboration>
  <bpmn:process id="Process_bpmn02" name="Construccion de horario en borrador" isExecutable="false">
    <bpmn:laneSet id="LaneSet_bpmn02">
      <bpmn:lane id="Lane_bpmn02_1" name="Sistema">
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_bpmn02_0" name="Coordinador">
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:task id="t6" name="Guardar horario como borrador">
      <bpmn:incoming>Flow_bpmn02_9</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn02_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="e1" name="Horario guardado en borrador">
      <bpmn:incoming>Flow_bpmn02_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="t3" name="Validar conflicto en vivo">
      <bpmn:incoming>Flow_bpmn02_2</bpmn:incoming>
      <bpmn:incoming>Flow_bpmn02_5</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn02_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:startEvent id="s1" name="Solicitud de creacion o edicion de horario">
      <bpmn:outgoing>Flow_bpmn02_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="t1" name="Seleccionar ficha, periodo y nombre">
      <bpmn:incoming>Flow_bpmn02_0</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn02_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t2" name="Agregar sesion (competencia, instructor, ambiente, franja)">
      <bpmn:incoming>Flow_bpmn02_1</bpmn:incoming>
      <bpmn:incoming>Flow_bpmn02_8</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn02_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t5" name="Guardar sesion en el horario">
      <bpmn:incoming>Flow_bpmn02_6</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn02_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t4" name="Ajustar datos de la sesion">
      <bpmn:incoming>Flow_bpmn02_4</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn02_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g2" name="Agregar otra sesion?">
      <bpmn:incoming>Flow_bpmn02_7</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn02_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_bpmn02_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="g1" name="Conflicto detectado?">
      <bpmn:incoming>Flow_bpmn02_3</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn02_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_bpmn02_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_bpmn02_9" name="No" sourceRef="g2" targetRef="t6" />
    <bpmn:sequenceFlow id="Flow_bpmn02_10" sourceRef="t6" targetRef="e1" />
    <bpmn:sequenceFlow id="Flow_bpmn02_2" sourceRef="t2" targetRef="t3" />
    <bpmn:sequenceFlow id="Flow_bpmn02_5" sourceRef="t4" targetRef="t3" />
    <bpmn:sequenceFlow id="Flow_bpmn02_3" sourceRef="t3" targetRef="g1" />
    <bpmn:sequenceFlow id="Flow_bpmn02_0" sourceRef="s1" targetRef="t1" />
    <bpmn:sequenceFlow id="Flow_bpmn02_1" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="Flow_bpmn02_8" name="Si" sourceRef="g2" targetRef="t2" />
    <bpmn:sequenceFlow id="Flow_bpmn02_6" name="No" sourceRef="g1" targetRef="t5" />
    <bpmn:sequenceFlow id="Flow_bpmn02_7" sourceRef="t5" targetRef="g2" />
    <bpmn:sequenceFlow id="Flow_bpmn02_4" name="Si" sourceRef="g1" targetRef="t4" />
  </bpmn:process>
