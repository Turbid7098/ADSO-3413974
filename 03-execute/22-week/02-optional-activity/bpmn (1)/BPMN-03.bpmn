<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_bpmn03" targetNamespace="http://sena.edu.co/bpmn/bpmn03" exporter="Camunda Modeler" exporterVersion="5.50.1">
  <bpmn:collaboration id="Collaboration_bpmn03">
    <bpmn:participant id="Pool_bpmn03" name="Publicacion de horario" processRef="Process_bpmn03" />
  </bpmn:collaboration>
  <bpmn:process id="Process_bpmn03" name="Publicacion de horario" isExecutable="false">
    <bpmn:laneSet id="LaneSet_bpmn03">
      <bpmn:lane id="Lane_bpmn03_1" name="Sistema">
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_bpmn03_0" name="Coordinador">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Solicitud de publicacion de horario">
      <bpmn:outgoing>Flow_bpmn03_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="t1" name="Solicitar publicacion">
      <bpmn:incoming>Flow_bpmn03_0</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn03_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t2" name="Verificar conflictos pendientes">
      <bpmn:incoming>Flow_bpmn03_1</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn03_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g1" name="Existen conflictos pendientes?">
      <bpmn:incoming>Flow_bpmn03_2</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn03_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_bpmn03_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t3" name="Mostrar resumen de publicacion">
      <bpmn:incoming>Flow_bpmn03_4</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn03_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t4" name="Confirmar publicacion">
      <bpmn:incoming>Flow_bpmn03_5</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn03_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t5" name="Publicar horario">
      <bpmn:incoming>Flow_bpmn03_6</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn03_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="e1" name="Horario publicado">
      <bpmn:incoming>Flow_bpmn03_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_bpmn03_0" sourceRef="s1" targetRef="t1" />
    <bpmn:sequenceFlow id="Flow_bpmn03_1" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="Flow_bpmn03_2" sourceRef="t2" targetRef="g1" />
    <bpmn:sequenceFlow id="Flow_bpmn03_3" name="Si" sourceRef="g1" targetRef="e2" />
    <bpmn:sequenceFlow id="Flow_bpmn03_4" name="No" sourceRef="g1" targetRef="t3" />
    <bpmn:sequenceFlow id="Flow_bpmn03_5" sourceRef="t3" targetRef="t4" />
    <bpmn:sequenceFlow id="Flow_bpmn03_6" sourceRef="t4" targetRef="t5" />
    <bpmn:sequenceFlow id="Flow_bpmn03_7" sourceRef="t5" targetRef="e1" />
    <bpmn:endEvent id="e2" name="Publicacion bloqueada">
      <bpmn:incoming>Flow_bpmn03_3</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
