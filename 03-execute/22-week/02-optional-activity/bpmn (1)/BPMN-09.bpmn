<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_bpmn09" targetNamespace="http://sena.edu.co/bpmn/bpmn09" exporter="Camunda Modeler" exporterVersion="5.50.1">
  <bpmn:collaboration id="Collaboration_bpmn09">
    <bpmn:participant id="Pool_bpmn09" name="Seguimiento academico" processRef="Process_bpmn09" />
  </bpmn:collaboration>
  <bpmn:process id="Process_bpmn09" name="Seguimiento academico" isExecutable="false">
    <bpmn:laneSet id="LaneSet_bpmn09">
      <bpmn:lane id="Lane_bpmn09_1" name="Sistema">
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_bpmn09_0" name="Instructor">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Necesidad de registrar seguimiento">
      <bpmn:outgoing>Flow_bpmn09_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="t1" name="Seleccionar ficha y tipo de sesion">
      <bpmn:incoming>Flow_bpmn09_0</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn09_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t2" name="Registrar asistentes y avance curricular">
      <bpmn:incoming>Flow_bpmn09_1</bpmn:incoming>
      <bpmn:incoming>Flow_bpmn09_4</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn09_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g1" name="Asistentes &#60;= total aprendices?">
      <bpmn:incoming>Flow_bpmn09_2</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn09_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_bpmn09_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t4" name="Calcular indicadores (asistencia, riesgo)">
      <bpmn:incoming>Flow_bpmn09_5</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn09_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t5" name="Guardar seguimiento">
      <bpmn:incoming>Flow_bpmn09_6</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn09_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="e1" name="Seguimiento registrado">
      <bpmn:incoming>Flow_bpmn09_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_bpmn09_0" sourceRef="s1" targetRef="t1" />
    <bpmn:sequenceFlow id="Flow_bpmn09_1" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="Flow_bpmn09_4" sourceRef="t3" targetRef="t2" />
    <bpmn:sequenceFlow id="Flow_bpmn09_2" sourceRef="t2" targetRef="g1" />
    <bpmn:sequenceFlow id="Flow_bpmn09_3" name="No" sourceRef="g1" targetRef="t3" />
    <bpmn:sequenceFlow id="Flow_bpmn09_5" name="Si" sourceRef="g1" targetRef="t4" />
    <bpmn:sequenceFlow id="Flow_bpmn09_6" sourceRef="t4" targetRef="t5" />
    <bpmn:sequenceFlow id="Flow_bpmn09_7" sourceRef="t5" targetRef="e1" />
    <bpmn:task id="t3" name="Informar error de validacion">
      <bpmn:incoming>Flow_bpmn09_3</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn09_4</bpmn:outgoing>
    </bpmn:task>
  </bpmn:process>
