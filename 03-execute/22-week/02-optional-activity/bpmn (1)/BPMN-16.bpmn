<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_bpmn16" targetNamespace="http://sena.edu.co/bpmn/bpmn16" exporter="Camunda Modeler" exporterVersion="5.50.1">
  <bpmn:collaboration id="Collaboration_bpmn16">
    <bpmn:participant id="Pool_bpmn16" name="Parametrizacion de catalogos y parametros" processRef="Process_bpmn16" />
  </bpmn:collaboration>
  <bpmn:process id="Process_bpmn16" name="Parametrizacion de catalogos y parametros" isExecutable="false">
    <bpmn:laneSet id="LaneSet_bpmn16">
      <bpmn:lane id="Lane_bpmn16_3" name="Sistema">
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_bpmn16_2" name="SYSTEM_ADMIN">
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_bpmn16_1" name="ADMIN_STAFF">
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_bpmn16_0" name="Director / Soporte (consulta)">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Necesidad de gestionar catalogo o parametro">
      <bpmn:outgoing>Flow_bpmn16_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="t1" name="Consultar catalogo o parametro">
      <bpmn:incoming>Flow_bpmn16_0</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn16_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g1" name="Rol autorizado para editar?">
      <bpmn:incoming>Flow_bpmn16_1</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn16_2</bpmn:outgoing>
      <bpmn:outgoing>Flow_bpmn16_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="g2" name="Catalogo o parametro del sistema?">
      <bpmn:incoming>Flow_bpmn16_3</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn16_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_bpmn16_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t5" name="Guardar parametro actualizado">
      <bpmn:incoming>Flow_bpmn16_7</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn16_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t4" name="Guardar catalogo actualizado">
      <bpmn:incoming>Flow_bpmn16_6</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn16_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="e1" name="Catalogo actualizado">
      <bpmn:incoming>Flow_bpmn16_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="e2" name="Consulta de solo lectura">
      <bpmn:incoming>Flow_bpmn16_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="t3" name="Editar parametro del sistema">
      <bpmn:incoming>Flow_bpmn16_5</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn16_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t2" name="Editar catalogo o valor de referencia">
      <bpmn:incoming>Flow_bpmn16_4</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn16_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_bpmn16_0" sourceRef="s1" targetRef="t1" />
    <bpmn:sequenceFlow id="Flow_bpmn16_1" sourceRef="t1" targetRef="g1" />
    <bpmn:sequenceFlow id="Flow_bpmn16_2" name="No" sourceRef="g1" targetRef="e2" />
    <bpmn:sequenceFlow id="Flow_bpmn16_3" name="Si" sourceRef="g1" targetRef="g2" />
    <bpmn:sequenceFlow id="Flow_bpmn16_4" name="Catalogo" sourceRef="g2" targetRef="t2" />
    <bpmn:sequenceFlow id="Flow_bpmn16_5" name="Parametro" sourceRef="g2" targetRef="t3" />
    <bpmn:sequenceFlow id="Flow_bpmn16_7" sourceRef="t3" targetRef="t5" />
    <bpmn:sequenceFlow id="Flow_bpmn16_9" sourceRef="t5" targetRef="e3" />
    <bpmn:sequenceFlow id="Flow_bpmn16_6" sourceRef="t2" targetRef="t4" />
    <bpmn:sequenceFlow id="Flow_bpmn16_8" sourceRef="t4" targetRef="e1" />
    <bpmn:endEvent id="e3" name="Parametro actualizado">
      <bpmn:incoming>Flow_bpmn16_9</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
