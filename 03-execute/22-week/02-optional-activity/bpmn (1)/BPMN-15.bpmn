      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t3_di" bpmnElement="t3">
        <omgdc:Bounds x="660.0" y="53.0" width="130" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e1_di" bpmnElement="e1">
        <omgdc:Bounds x="882.0" y="275.0" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_bpmn15_0_di" bpmnElement="Flow_bpmn15_0">
        <omgdi:waypoint x="218.0" y="88.0"/>
        <omgdi:waypoint x="310.0" y="88.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_bpmn15_1_di" bpmnElement="Flow_bpmn15_1">
        <omgdi:waypoint x="440.0" y="88.0"/>
