<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_bpmn13" targetNamespace="http://sena.edu.co/bpmn/bpmn13" exporter="Camunda Modeler" exporterVersion="5.50.1">
  <bpmn:collaboration id="Collaboration_bpmn13">
    <bpmn:participant id="Pool_bpmn13" name="Gestion de usuarios y roles" processRef="Process_bpmn13" />
  </bpmn:collaboration>
  <bpmn:process id="Process_bpmn13" name="Gestion de usuarios y roles" isExecutable="false">
    <bpmn:laneSet id="LaneSet_bpmn13">
      <bpmn:lane id="Lane_bpmn13_1" name="Sistema">
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_bpmn13_0" name="Director">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Necesidad de gestionar un usuario">
      <bpmn:outgoing>Flow_bpmn13_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="t1" name="Consultar y filtrar usuarios">
      <bpmn:incoming>Flow_bpmn13_0</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn13_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t2" name="Crear o editar usuario">
      <bpmn:incoming>Flow_bpmn13_1</bpmn:incoming>
      <bpmn:incoming>Flow_bpmn13_5</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn13_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t3" name="Validar datos del usuario">
      <bpmn:incoming>Flow_bpmn13_2</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn13_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g1" name="Datos validos?">
      <bpmn:incoming>Flow_bpmn13_3</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn13_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_bpmn13_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t5" name="Guardar usuario">
      <bpmn:incoming>Flow_bpmn13_6</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn13_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t6" name="Asignar o revocar rol">
      <bpmn:incoming>Flow_bpmn13_7</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn13_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t7" name="Actualizar permisos del usuario">
      <bpmn:incoming>Flow_bpmn13_8</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn13_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="e1" name="Usuario actualizado">
      <bpmn:incoming>Flow_bpmn13_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_bpmn13_0" sourceRef="s1" targetRef="t1" />
    <bpmn:sequenceFlow id="Flow_bpmn13_1" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="Flow_bpmn13_5" sourceRef="t4" targetRef="t2" />
    <bpmn:sequenceFlow id="Flow_bpmn13_2" sourceRef="t2" targetRef="t3" />
    <bpmn:sequenceFlow id="Flow_bpmn13_3" sourceRef="t3" targetRef="g1" />
    <bpmn:sequenceFlow id="Flow_bpmn13_4" name="No" sourceRef="g1" targetRef="t4" />
    <bpmn:sequenceFlow id="Flow_bpmn13_6" name="Si" sourceRef="g1" targetRef="t5" />
    <bpmn:sequenceFlow id="Flow_bpmn13_7" sourceRef="t5" targetRef="t6" />
    <bpmn:sequenceFlow id="Flow_bpmn13_8" sourceRef="t6" targetRef="t7" />
    <bpmn:sequenceFlow id="Flow_bpmn13_9" sourceRef="t7" targetRef="e1" />
    <bpmn:task id="t4" name="Informar error de validacion">
      <bpmn:incoming>Flow_bpmn13_4</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn13_5</bpmn:outgoing>
    </bpmn:task>
  </bpmn:process>
