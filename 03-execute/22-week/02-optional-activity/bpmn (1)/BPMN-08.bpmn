<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_bpmn08" targetNamespace="http://sena.edu.co/bpmn/bpmn08" exporter="Camunda Modeler" exporterVersion="5.50.1">
  <bpmn:collaboration id="Collaboration_bpmn08">
    <bpmn:participant id="Pool_bpmn08" name="Registro de ejecucion de sesion" processRef="Process_bpmn08" />
  </bpmn:collaboration>
  <bpmn:process id="Process_bpmn08" name="Registro de ejecucion de sesion" isExecutable="false">
    <bpmn:laneSet id="LaneSet_bpmn08">
      <bpmn:lane id="Lane_bpmn08_1" name="Sistema">
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_bpmn08_0" name="Instructor">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Sesion finalizada, pendiente de registro">
      <bpmn:outgoing>Flow_bpmn08_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="t1" name="Abrir detalle de la sesion">
      <bpmn:incoming>Flow_bpmn08_0</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn08_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t2" name="Marcar resultado de la sesion">
      <bpmn:incoming>Flow_bpmn08_1</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn08_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g1" name="Sesion ejecutada?">
      <bpmn:incoming>Flow_bpmn08_2</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn08_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_bpmn08_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t3" name="Registrar sesion como ejecutada">
      <bpmn:incoming>Flow_bpmn08_3</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn08_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t4" name="Registrar sesion como no ejecutada">
      <bpmn:incoming>Flow_bpmn08_5</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn08_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="e1" name="Sesion ejecutada">
      <bpmn:incoming>Flow_bpmn08_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="e2" name="Sesion no ejecutada">
      <bpmn:incoming>Flow_bpmn08_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_bpmn08_0" sourceRef="s1" targetRef="t1" />
    <bpmn:sequenceFlow id="Flow_bpmn08_1" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="Flow_bpmn08_2" sourceRef="t2" targetRef="g1" />
    <bpmn:sequenceFlow id="Flow_bpmn08_3" name="Si" sourceRef="g1" targetRef="t3" />
    <bpmn:sequenceFlow id="Flow_bpmn08_5" name="No" sourceRef="g1" targetRef="t4" />
    <bpmn:sequenceFlow id="Flow_bpmn08_4" sourceRef="t3" targetRef="e1" />
    <bpmn:sequenceFlow id="Flow_bpmn08_6" sourceRef="t4" targetRef="e2" />
  </bpmn:process>
