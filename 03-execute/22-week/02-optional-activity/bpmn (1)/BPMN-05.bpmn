<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_bpmn05" targetNamespace="http://sena.edu.co/bpmn/bpmn05" exporter="Camunda Modeler" exporterVersion="5.50.1">
  <bpmn:collaboration id="Collaboration_bpmn05">
    <bpmn:participant id="Pool_bpmn05" name="Gestion de excepciones de disponibilidad" processRef="Process_bpmn05" />
  </bpmn:collaboration>
  <bpmn:process id="Process_bpmn05" name="Gestion de excepciones de disponibilidad del instructor" isExecutable="false">
    <bpmn:laneSet id="LaneSet_bpmn05">
      <bpmn:lane id="Lane_bpmn05_2" name="Sistema">
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_bpmn05_1" name="Coordinador">
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_bpmn05_0" name="Instructor">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Solicitud de excepcion de disponibilidad">
      <bpmn:outgoing>Flow_bpmn05_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="t1" name="Seleccionar tipo de excepcion">
      <bpmn:incoming>Flow_bpmn05_0</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn05_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t2" name="Adjuntar documento de soporte">
      <bpmn:incoming>Flow_bpmn05_1</bpmn:incoming>
      <bpmn:incoming>Flow_bpmn05_4</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn05_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g1" name="Soporte obligatorio adjunto?">
      <bpmn:incoming>Flow_bpmn05_2</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn05_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_bpmn05_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t4" name="Registrar solicitud como pendiente">
      <bpmn:incoming>Flow_bpmn05_5</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn05_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t5" name="Revisar solicitud">
      <bpmn:incoming>Flow_bpmn05_6</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn05_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g2" name="Se aprueba la excepcion?">
      <bpmn:incoming>Flow_bpmn05_7</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn05_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_bpmn05_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t3" name="Informar que el soporte es obligatorio">
      <bpmn:incoming>Flow_bpmn05_3</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn05_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t6" name="Aprobar y reprogramar sesiones afectadas">
      <bpmn:incoming>Flow_bpmn05_8</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn05_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="e1" name="Excepcion aprobada">
      <bpmn:incoming>Flow_bpmn05_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="t7" name="Registrar rechazo">
      <bpmn:incoming>Flow_bpmn05_10</bpmn:incoming>
      <bpmn:outgoing>Flow_bpmn05_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="e2" name="Excepcion rechazada">
      <bpmn:incoming>Flow_bpmn05_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_bpmn05_0" sourceRef="s1" targetRef="t1" />
    <bpmn:sequenceFlow id="Flow_bpmn05_1" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="Flow_bpmn05_4" sourceRef="t3" targetRef="t2" />
    <bpmn:sequenceFlow id="Flow_bpmn05_2" sourceRef="t2" targetRef="g1" />
    <bpmn:sequenceFlow id="Flow_bpmn05_3" name="No" sourceRef="g1" targetRef="t3" />
    <bpmn:sequenceFlow id="Flow_bpmn05_5" name="Si" sourceRef="g1" targetRef="t4" />
    <bpmn:sequenceFlow id="Flow_bpmn05_6" sourceRef="t4" targetRef="t5" />
    <bpmn:sequenceFlow id="Flow_bpmn05_7" sourceRef="t5" targetRef="g2" />
    <bpmn:sequenceFlow id="Flow_bpmn05_8" name="Si" sourceRef="g2" targetRef="t6" />
    <bpmn:sequenceFlow id="Flow_bpmn05_10" name="No" sourceRef="g2" targetRef="t7" />
    <bpmn:sequenceFlow id="Flow_bpmn05_9" sourceRef="t6" targetRef="e1" />
    <bpmn:sequenceFlow id="Flow_bpmn05_11" sourceRef="t7" targetRef="e2" />
  </bpmn:process>
