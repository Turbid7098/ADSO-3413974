<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_bpmn07" targetNamespace="http://sena.edu.co/bpmn/bpmn07">
  <bpmn:collaboration id="Collaboration_bpmn07">
    <bpmn:participant id="Pool_bpmn07" name="Notificaciones" processRef="Process_bpmn07"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_bpmn07" name="Notificaciones" isExecutable="false">
    <bpmn:laneSet id="LaneSet_bpmn07">
      <bpmn:lane id="Lane_bpmn07_0" name="Sistema">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_bpmn07_1" name="Usuario">
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Evento del sistema (cambio, publicacion, cancelacion)"><bpmn:outgoing>Flow_bpmn07_0</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="t1" name="Generar notificacion (tipo y prioridad)"><bpmn:incoming>Flow_bpmn07_0</bpmn:incoming><bpmn:outgoing>Flow_bpmn07_1</bpmn:outgoing></bpmn:task>
    <bpmn:task id="t2" name="Registrar en bandeja del destinatario"><bpmn:incoming>Flow_bpmn07_1</bpmn:incoming><bpmn:outgoing>Flow_bpmn07_2</bpmn:outgoing></bpmn:task>
    <bpmn:task id="t3" name="Consultar panel de notificaciones"><bpmn:incoming>Flow_bpmn07_2</bpmn:incoming><bpmn:outgoing>Flow_bpmn07_3</bpmn:outgoing></bpmn:task>
    <bpmn:task id="t4" name="Abrir detalle de notificacion"><bpmn:incoming>Flow_bpmn07_3</bpmn:incoming><bpmn:outgoing>Flow_bpmn07_4</bpmn:outgoing></bpmn:task>
    <bpmn:task id="t5" name="Ir al horario relacionado"><bpmn:incoming>Flow_bpmn07_4</bpmn:incoming><bpmn:outgoing>Flow_bpmn07_5</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="e1" name="Notificacion atendida"><bpmn:incoming>Flow_bpmn07_5</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_bpmn07_0" sourceRef="s1" targetRef="t1"/>
    <bpmn:sequenceFlow id="Flow_bpmn07_1" sourceRef="t1" targetRef="t2"/>
    <bpmn:sequenceFlow id="Flow_bpmn07_2" sourceRef="t2" targetRef="t3"/>
    <bpmn:sequenceFlow id="Flow_bpmn07_3" sourceRef="t3" targetRef="t4"/>
    <bpmn:sequenceFlow id="Flow_bpmn07_4" sourceRef="t4" targetRef="t5"/>
    <bpmn:sequenceFlow id="Flow_bpmn07_5" sourceRef="t5" targetRef="e1"/>
  </bpmn:process>
