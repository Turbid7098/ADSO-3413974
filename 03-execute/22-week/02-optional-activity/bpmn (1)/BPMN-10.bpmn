<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_bpmn10" targetNamespace="http://sena.edu.co/bpmn/bpmn10">
  <bpmn:collaboration id="Collaboration_bpmn10">
    <bpmn:participant id="Pool_bpmn10" name="Consulta de disponibilidad" processRef="Process_bpmn10"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_bpmn10" name="Consulta de disponibilidad de ambientes e instructores" isExecutable="false">
    <bpmn:laneSet id="LaneSet_bpmn10">
      <bpmn:lane id="Lane_bpmn10_0" name="Coordinador">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_bpmn10_1" name="Sistema">
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Necesidad de consultar disponibilidad"><bpmn:outgoing>Flow_bpmn10_0</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="t1" name="Seleccionar fecha, hora y tipo"><bpmn:incoming>Flow_bpmn10_0</bpmn:incoming><bpmn:outgoing>Flow_bpmn10_1</bpmn:outgoing></bpmn:task>
    <bpmn:task id="t2" name="Consultar ocupacion por franja"><bpmn:incoming>Flow_bpmn10_1</bpmn:incoming><bpmn:outgoing>Flow_bpmn10_2</bpmn:outgoing></bpmn:task>
    <bpmn:task id="t3" name="Ver detalle de ambiente (aforo, inspeccion, mantenimiento)"><bpmn:incoming>Flow_bpmn10_2</bpmn:incoming><bpmn:outgoing>Flow_bpmn10_3</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="e1" name="Disponibilidad consultada"><bpmn:incoming>Flow_bpmn10_3</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_bpmn10_0" sourceRef="s1" targetRef="t1"/>
    <bpmn:sequenceFlow id="Flow_bpmn10_1" sourceRef="t1" targetRef="t2"/>
    <bpmn:sequenceFlow id="Flow_bpmn10_2" sourceRef="t2" targetRef="t3"/>
    <bpmn:sequenceFlow id="Flow_bpmn10_3" sourceRef="t3" targetRef="e1"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_bpmn10">
    <bpmndi:BPMNPlane id="Plane_bpmn10" bpmnElement="Collaboration_bpmn10">
      <bpmndi:BPMNShape id="Pool_bpmn10_di" bpmnElement="Pool_bpmn10" isHorizontal="true">
        <omgdc:Bounds x="60" y="30" width="1040" height="430"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_bpmn10_0_di" bpmnElement="Lane_bpmn10_0" isHorizontal="true">
        <omgdc:Bounds x="90" y="30" width="1010" height="205"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_bpmn10_1_di" bpmnElement="Lane_bpmn10_1" isHorizontal="true">
        <omgdc:Bounds x="90" y="235" width="1010" height="205"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s1_di" bpmnElement="s1">
        <omgdc:Bounds x="182.0" y="70.0" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t1_di" bpmnElement="t1">
        <omgdc:Bounds x="310.0" y="53.0" width="130" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t2_di" bpmnElement="t2">
        <omgdc:Bounds x="485.0" y="258.0" width="130" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t3_di" bpmnElement="t3">
        <omgdc:Bounds x="660.0" y="53.0" width="130" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e1_di" bpmnElement="e1">
        <omgdc:Bounds x="882.0" y="275.0" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_bpmn10_0_di" bpmnElement="Flow_bpmn10_0">
        <omgdi:waypoint x="218.0" y="88.0"/>
        <omgdi:waypoint x="310.0" y="88.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_bpmn10_1_di" bpmnElement="Flow_bpmn10_1">
        <omgdi:waypoint x="440.0" y="88.0"/>
        <omgdi:waypoint x="462.5" y="88.0"/>
        <omgdi:waypoint x="462.5" y="293.0"/>
        <omgdi:waypoint x="485.0" y="293.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_bpmn10_2_di" bpmnElement="Flow_bpmn10_2">
        <omgdi:waypoint x="615.0" y="293.0"/>
        <omgdi:waypoint x="637.5" y="293.0"/>
        <omgdi:waypoint x="637.5" y="88.0"/>
        <omgdi:waypoint x="660.0" y="88.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_bpmn10_3_di" bpmnElement="Flow_bpmn10_3">
        <omgdi:waypoint x="790.0" y="88.0"/>
        <omgdi:waypoint x="836.0" y="88.0"/>
        <omgdi:waypoint x="836.0" y="293.0"/>
        <omgdi:waypoint x="882.0" y="293.0"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>